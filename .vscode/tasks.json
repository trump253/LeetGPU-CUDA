{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CUDA: configure release",
      "type": "process",
      "command": "/usr/local/bin/cmake",
      "args": [
        "--preset",
        "release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CUDA: build current exercise",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/run.py",
        "${file}",
        "--build-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CUDA: run current exercise",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/run.py",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CUDA: check current exercise (small)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/run.py",
        "${file}",
        "--",
        "--size",
        "small",
        "--check-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CUDA: build debug current exercise",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/run.py",
        "${file}",
        "--preset",
        "debug",
        "--build-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CUDA: list current exercise versions",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/run.py",
        "${file}",
        "--",
        "--list-versions"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CUDA: run current exercise (choose version)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/run.py",
        "${file}",
        "--",
        "--version",
        "${input:solutionVersion}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CUDA: compare current exercise versions (small)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/run.py",
        "${file}",
        "--",
        "--version",
        "all",
        "--size",
        "small"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ],
  "inputs": [
    {
      "id": "solutionVersion",
      "type": "promptString",
      "description": "版本 ID、名称、all 或 default",
      "default": "default"
    }
  ]
}
