{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CUDA: configure release",
      "type": "process",
      "command": "/usr/local/bin/cmake",
      "args": [
        "--preset",
        "release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CUDA: build current exercise",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/run.py",
        "${file}",
        "--build-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CUDA: run current exercise",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/run.py",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CUDA: check current exercise (small)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/run.py",
        "${file}",
        "--",
        "--size",
        "small",
        "--check-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CUDA: build debug current exercise",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/run.py",
        "${file}",
        "--preset",
        "debug",
        "--build-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
