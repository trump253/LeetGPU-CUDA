{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CUDA: debug current exercise (cuda-gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/p${fileDirnameBasename}",
      "args": [
        "--size",
        "small",
        "--check-only"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/local/cuda/bin/cuda-gdb",
      "preLaunchTask": "CUDA: build debug current exercise",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
